<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/workout_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="80dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_workout_label"
                android:textColor="@color/workout_card_dark"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Nome do Treino -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilWorkoutName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="@string/workout_name_hint"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/workout_cyan"
                app:hintTextColor="@color/workout_cyan"
                app:layout_constraintTop_toBottomOf="@id/tvTitle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWorkoutName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/workout_card_dark" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Categoria -->
            <TextView
                android:id="@+id/tvCategoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/select_category"
                android:textColor="@color/workout_card_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:alpha="0.7"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilWorkoutName" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroupCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@+id/btnHypertrophy"
                app:layout_constraintTop_toBottomOf="@id/tvCategoryTitle">

                <Button
                    android:id="@+id/btnHypertrophy"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/category_hypertrophy"
                    android:textColor="@color/workout_card_dark"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnStrength"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/category_strength"
                    android:textColor="@color/workout_card_dark"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnEndurance"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/category_endurance"
                    android:textColor="@color/workout_card_dark"
                    android:textSize="10sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Lista de Exercícios -->
            <TextView
                android:id="@+id/tvExercisesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/added_exercises"
                android:textColor="@color/workout_card_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:alpha="0.7"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/toggleGroupCategory" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAddedExercises"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tvExercisesTitle"
                tools:listitem="@layout/item_added_exercise" />

            <!-- Adicionar Exercício -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddExercise"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:text="@string/add_exercise"
                android:textColor="@color/workout_cyan"
                app:icon="@android:drawable/ic_input_add"
                app:iconGravity="textStart"
                app:iconTint="@color/workout_cyan"
                app:strokeColor="@color/workout_cyan"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                app:layout_constraintTop_toBottomOf="@id/rvAddedExercises" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Rodapé Fixo -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardElevation="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveWorkout"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="16dp"
            android:backgroundTint="@color/workout_green"
            android:text="@string/save_workout_local"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>